{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diyu-cbfsk.local/m1/persona_memory_snapshot.schema.v0.1.json",
  "title": "PersonaMemorySnapshot",
  "object_id": "IN-10",
  "description": "特定版本下已发布观点、栏目、语言辨识度、修订原因和待处理冲突的可重放快照（D-20 第二对象）。",
  "schema_version": "0.1",
  "prd_anchors": ["PRD-5.5", "PRD-6.1", "D-20"],
  "persistence_class": "long_term_truth",
  "type": "object",
  "required": ["snapshot_id", "persona_id", "version", "persistence_class", "replayable", "published_viewpoint_refs", "language_signature"],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "persona_id": { "type": "string", "minLength": 1 },
    "version": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/objectVersion" },
    "persistence_class": { "const": "long_term_truth" },
    "replayable": { "const": true },
    "published_viewpoint_refs": { "type": "array", "items": { "type": "string" } },
    "columns": { "type": "array", "items": { "type": "string" } },
    "language_signature": {
      "type": "object",
      "required": ["markers"],
      "additionalProperties": false,
      "properties": {
        "markers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "distinctiveness_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "revision_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision_id", "reason", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "revision_id": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pending_conflict_refs": { "type": "array", "items": { "type": "string" } },
    "underlying_model_version": {
      "description": "底层模型切换不得造成无依据人设漂移；记下模型版本才能事后归因。",
      "type": "string"
    },
    "fail_closed_state": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/failClosedState" },
    "is_production_memory_store": { "const": false }
  }
}
