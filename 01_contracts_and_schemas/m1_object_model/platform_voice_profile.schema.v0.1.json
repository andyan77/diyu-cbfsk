{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diyu-cbfsk.local/m1/platform_voice_profile.schema.v0.1.json",
  "title": "PlatformVoiceProfile",
  "object_id": "D-21-01",
  "description": "平台语感画像（D-21 / C-14）：把已接受的专业判断转成平台原生、口播自然、非课件非模板非 AI 腔的表达约束。语感位于事实与人设之下，不得覆盖二者。",
  "schema_version": "0.1",
  "prd_anchors": ["PRD-5.5", "PRD-5.7", "D-21", "C-14"],
  "persistence_class": "long_term_truth",
  "type": "object",
  "required": ["voice_profile_id", "platform", "version", "persistence_class", "anti_template_constraints", "authority_rank"],
  "additionalProperties": false,
  "properties": {
    "voice_profile_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "version": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/objectVersion" },
    "persistence_class": { "const": "long_term_truth" },
    "spoken_rhythm": { "type": "string" },
    "pause_and_turn_patterns": { "type": "array", "items": { "type": "string" } },
    "viewpoint_timing": { "type": "string" },
    "shot_actions": { "type": "array", "items": { "type": "string" } },
    "professional_density": { "type": "number", "minimum": 0, "maximum": 1 },
    "anti_template_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["no_courseware_tone", "no_template_scaffolding", "no_ai_register", "no_generic_opener", "no_listicle_padding"] },
      "uniqueItems": true
    },
    "authority_rank": {
      "description": "PRD 5.5：平台表达偏好排在搭配师人设之下。",
      "type": "object",
      "required": ["may_override_persona", "may_override_facts"],
      "additionalProperties": false,
      "properties": {
        "may_override_persona": { "const": false },
        "may_override_facts": { "const": false }
      }
    }
  }
}
