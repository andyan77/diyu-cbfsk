{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diyu-cbfsk.local/m1/product_image_asset_bundle.schema.v0.1.json",
  "title": "ProductImageAssetBundle",
  "object_id": "IN-08",
  "description": "商品图片资产、来源、版本、角度、质量、权利保密标记及可用范围（D-23）。",
  "schema_version": "0.1",
  "prd_anchors": ["PRD-6.1", "PRD-5.6", "D-23"],
  "persistence_class": "long_term_truth",
  "type": "object",
  "required": ["bundle_id", "version", "persistence_class", "assets", "usage_scope"],
  "additionalProperties": false,
  "properties": {
    "bundle_id": { "type": "string", "minLength": 1 },
    "version": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/objectVersion" },
    "persistence_class": { "const": "long_term_truth" },
    "sku_id": { "type": "string" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "source", "angle", "quality"],
        "additionalProperties": false,
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["brand_official", "supplier", "store_capture", "synthetic_fixture"] },
          "image_version": { "type": "string" },
          "angle": { "type": "string", "enum": ["front", "back", "side", "detail", "worn", "flat_lay"] },
          "quality": {
            "type": "object",
            "required": ["resolution_sufficient", "lighting_sufficient"],
            "additionalProperties": false,
            "properties": {
              "resolution_sufficient": { "type": "boolean" },
              "lighting_sufficient": { "type": "boolean" },
              "occlusion_present": { "type": "boolean" }
            }
          },
          "rights": {
            "type": "object",
            "required": ["confidential", "redistributable"],
            "additionalProperties": false,
            "properties": {
              "confidential": { "type": "boolean" },
              "redistributable": { "type": "boolean" },
              "license_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "usage_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["internal_analysis", "content_production", "test_production_only", "hidden_benchmark_forbidden"] }
    },
    "cannot_evidence": {
      "description": "PRD 5.6 明令：图片不能作为成分、性能、库存或安全认证的证据。此处只作声明，实际拦截在 garment_and_inventory 的 attributeRecord 判据上。",
      "type": "array",
      "items": { "type": "string", "enum": ["composition", "performance", "inventory", "safety_certification"] }
    },
    "multimodal_recognition_executed": {
      "description": "M1 红线：不得运行多模态商品识别并产生正式结果。本位只能为 false。",
      "const": false
    }
  }
}
