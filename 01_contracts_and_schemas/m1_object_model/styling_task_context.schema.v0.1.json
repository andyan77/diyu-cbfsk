{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diyu-cbfsk.local/m1/styling_task_context.schema.v0.1.json",
  "title": "StylingTaskContext",
  "object_id": "IN-07",
  "description": "本次任务目标、平台、账号角色、场景、天气、地区、内容栏目与经营目标。整体属运行时事实，不得回写长期真源。",
  "schema_version": "0.1",
  "prd_anchors": ["PRD-6.1"],
  "persistence_class": "runtime_fact",
  "type": "object",
  "required": ["task_id", "objective", "platform", "account_role", "persistence_class"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "persistence_class": { "const": "runtime_fact" },
    "objective": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "account_role": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string" },
    "weather": { "type": "string" },
    "region": { "type": "string" },
    "content_column": { "type": "string" },
    "business_goal": { "type": "string" },
    "category_id": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/categoryId" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "may_be_written_back_to_long_term_truth": { "const": false },
    "fail_closed_state": { "$ref": "https://diyu-cbfsk.local/m1/common_defs.schema.v0.1.json#/definitions/failClosedState" }
  }
}
